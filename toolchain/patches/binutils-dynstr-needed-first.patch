+/* Ask for the string at IDX to be placed at the start of the table,
+   before every string not so marked, when the table is finalized.
+   The marked strings keep their order among themselves.  */
+
+void
+_bfd_elf_strtab_place_first (struct elf_strtab_hash *tab, size_t idx)
+{
+  if (idx == 0 || idx == (size_t) -1)
+    return;
+  BFD_ASSERT (tab->sec_size == 0);
+  BFD_ASSERT (idx < tab->size);
+  tab->array[idx]->first = true;
+}
