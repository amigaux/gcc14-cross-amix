m68k: in the DImode shift-by-32 splits that store the zero half first, read the source at its moved address.

Author: Stefan Reinauer
Origin: https://github.com/AmigaPorts/gcc (branch amiga16.2, tag m68k-amigaos-gcc-v16.2-rc24) commit 40fc1b0f03695406e620bb63552968b56d433df9
Upstream: not in GCC
Licence: GPL-3.0-or-later, as the GCC sources it changes.
The diff only (testsuite files left out), rebased onto GCC 16.2.0 by hand:
the function goes before m68k_use_lra_p, which upstream ends with.

diff -u a/gcc/config/m68k/m68k.cc b/gcc/config/m68k/m68k.cc
--- a/gcc/config/m68k/m68k.cc
+++ b/gcc/config/m68k/m68k.cc
@@ -7288,6 +7288,19 @@
   return default_mode_for_floating_type (ti);
 }
 
+/* Adjust a source that is read after DST changes its address register.  */
+rtx
+m68k_adjust_for_autoinc (rtx src, rtx dst, int delta)
+{
+  if (!MEM_P (src) || !MEM_P (dst))
+    return src;
+  rtx a = XEXP (dst, 0);
+  if (GET_RTX_CLASS (GET_CODE (a)) != RTX_AUTOINC
+      || !reg_mentioned_p (XEXP (a, 0), XEXP (src, 0)))
+    return src;
+  return replace_equiv_address_nv (src, plus_constant (Pmode, XEXP (src, 0), delta));
+}
+
 /* Implement TARGET_LRA_P.  */
 
 static bool
diff -u a/gcc/config/m68k/m68k.md b/gcc/config/m68k/m68k.md
--- a/gcc/config/m68k/m68k.md
+++ b/gcc/config/m68k/m68k.md
@@ -4518,6 +4518,8 @@
 {
   operands[0] = adjust_address(operands[0], SImode, 0);
   operands[1] = gen_lowpart(SImode, operands[1]);
+  /* The zero is pushed first, moving a stack-slot source up four bytes.  */
+  operands[1] = m68k_adjust_for_autoinc (operands[1], operands[0], 4);
 })
 
 (define_split
@@ -5060,6 +5062,8 @@
 {
   operands[0] = adjust_address(operands[0], SImode, 0);
   operands[1] = gen_highpart(SImode, operands[1]);
+  /* The zero is stored first, moving a source using that address register.  */
+  operands[1] = m68k_adjust_for_autoinc (operands[1], operands[0], -4);
 })
 
 (define_split
diff -u a/gcc/config/m68k/m68k-protos.h b/gcc/config/m68k/m68k-protos.h
--- a/gcc/config/m68k/m68k-protos.h
+++ b/gcc/config/m68k/m68k-protos.h
@@ -77,6 +77,7 @@
 extern bool m68k_matches_u_p (rtx);
 extern rtx legitimize_pic_address (rtx, machine_mode, rtx);
 extern rtx m68k_legitimize_tls_address (rtx);
+extern rtx m68k_adjust_for_autoinc (rtx, rtx, int);
 extern bool m68k_tls_reference_p (rtx, bool);
 extern int valid_dbcc_comparison_p_2 (rtx, machine_mode);
 extern rtx m68k_libcall_value (machine_mode);
