m68k: SImode dbra loops end only on a borrow out of the high word; HImode counters in an address register are sign-extended before the compare.

Author: Tinic Uro
Origin: https://github.com/AmigaPorts/gcc (branch amiga16.2, tag m68k-amigaos-gcc-v16.2-rc24) commit f831bb994547bf348da8b0960d06c294acd95afc
Upstream: not in GCC
Licence: GPL-3.0-or-later, as the GCC sources it changes.
The diff only (testsuite files left out), rebased onto GCC 16.2.0 by hand:
upstream names the first pattern *dbne_hi.

diff -u a/gcc/config/m68k/m68k.cc b/gcc/config/m68k/m68k.cc
--- a/gcc/config/m68k/m68k.cc
+++ b/gcc/config/m68k/m68k.cc
@@ -1799,11 +1799,12 @@
     }
 
   /* If the decrement is to be done in SImode, then we have
-     to compensate for the fact that dbcc decrements in HImode.  */
+     to compensate for the fact that dbcc decrements in HImode.
+     Only a borrow out of the high word, a counter of 0, ends the loop.  */
   switch (GET_MODE (operands[0]))
     {
       case E_SImode:
-        output_asm_insn ("clr%.w %0\n\tsubq%.l #1,%0\n\tjpl %l1", operands);
+        output_asm_insn ("clr%.w %0\n\tsubq%.l #1,%0\n\tjcc %l1", operands);
         break;
 
       case E_HImode:
diff -u a/gcc/config/m68k/m68k.md b/gcc/config/m68k/m68k.md
--- a/gcc/config/m68k/m68k.md
+++ b/gcc/config/m68k/m68k.md
@@ -5875,7 +5875,9 @@
     return "dbra %0,%l1";
   if (GET_CODE (operands[0]) == MEM)
     return "subq%.w #1,%0\;jcc %l1";
-  return "subq%.w #1,%0\;cmp%.w #-1,%0\;jne %l1";
+  /* subq.w and cmp.w on an address register act on all 32 bits: sign-extend
+     the low word first, so that only the counter decides.  */
+  return "subq%.w #1,%0\;move%.w %0,%0\;cmp%.w #-1,%0\;jne %l1";
 })
 
 (define_insn "*dbne_si"
@@ -5916,7 +5918,9 @@
     return "dbra %0,%l1";
   if (GET_CODE (operands[0]) == MEM)
     return "subq%.w #1,%0\;jcc %l1";
-  return "subq%.w #1,%0\;cmp%.w #-1,%0\;jne %l1";
+  /* subq.w and cmp.w on an address register act on all 32 bits: sign-extend
+     the low word first, so that only the counter decides.  */
+  return "subq%.w #1,%0\;move%.w %0,%0\;cmp%.w #-1,%0\;jne %l1";
 })
 
 (define_expand "decrement_and_branch_until_zero"
